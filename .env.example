# ==============================================================================
# DemurrageOS Environment Configuration Template
# ==============================================================================

# Database - Supabase PostgreSQL
# DATABASE_URL: Supabase Transaction Pooler connection (port 6543) with connection pooling (e.g., PgBouncer).
# Used by the application at runtime for pooled database queries.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Direct connection (port 5432) bypassing the pooler.
# Required by Prisma CLI for running migrations, schema pushes, and introspection.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cache & Background Worker Queue
# REDIS_URL: Connection string for Redis, used by BullMQ background job queues and caching.
REDIS_URL="redis://localhost:6379"

# API Server
# PORT: HTTP server listening port for apps/api.
PORT=4000

# Inter-Service Endpoints
# AI_SERVICE_URL: Base URL pointing to the FastAPI OCR and Document Extraction AI microservice.
AI_SERVICE_URL="http://localhost:8000"

# Application Observability
# LOG_LEVEL: Controls application logging verbosity (e.g. error, warn, info, debug).
LOG_LEVEL="info"
