# Database Configuration (PostgreSQL in Docker / Production or SQLite fallback in Dev)
DATABASE_URL="postgresql://demurrage:demurrage_secret@localhost:5432/demurrageos?schema=public"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# Service URLs
PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
AI_SERVICE_URL="http://localhost:8000"

# AI Service Configuration
AI_EXTRACTION_MODEL="deepseek-ocr-v1"
AI_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Storage & Providers
DOCUMENT_STORAGE_PROVIDER="local"
DOCUMENT_STORAGE_PATH="./uploads"
NOTIFICATION_PROVIDER="console"

# Security & Internal Service Authentication
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-for-hmac-sha256"
INTERNAL_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"
CHROMA_DB_DIR="./chroma_db"
DPD_PICKUP_WINDOW_HOURS=48
NODE_ENV="development"
