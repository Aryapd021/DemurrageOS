datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CHA
  CLIENT
  EXTERNAL
}

enum DeliveryMode {
  DPD_DIRECT
  DPD_CFS
  CFS
}

enum ContainerStatus {
  IN_TRANSIT
  DISCHARGED
  CUSTOMS_HOLD
  OUT_FOR_DELIVERY
  DELIVERED
  EMPTY_RETURNED
}

enum ComplianceSignalType {
  DOC_COMPLETENESS
  HS_CODE_NOVELTY
  AEO_ACP_STATUS
  VALUATION_CONSISTENCY
}

enum SignalSource {
  MANUAL
  DERIVED
}

enum DocumentType {
  BILL_OF_LADING
  DELIVERY_ORDER
  BILL_OF_ENTRY
  CFS_GATE_PASS
  CARRIER_DD_INVOICE
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING_REVIEW
  ACCEPTED
  CORRECTED
  REJECTED
}

enum TaskType {
  PICKUP
  DOCUMENT_VERIFICATION
  CUSTOMS_CLEARANCE
  GATE_PASS_GENERATION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssigneeType {
  INTERNAL_USER
  EXTERNAL_CONTACT
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChargeType {
  DEMURRAGE
  DETENTION
  CFS_GROUND_RENT
  HANDLING
}

model Organization {
  id          String      @id @default(uuid())
  name        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       User[]
  clients     Client[]
  containers  Container[]
  documents   Document[]
  tasks       Task[]
  alerts      Alert[]
  auditLogs   AuditLog[]
  tariffs     Tariff[]
  cfsList     CFS[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  name           String
  role           Role         @default(CHA)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tasks          Task[]
}

model Client {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  iecCode        String?
  gstin          String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  aeoStatus      Boolean      @default(false)
  acpStatus      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  containers     Container[]
  documents      Document[]

  @@index([organizationId])
}

model CFS {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  location           String?
  groundRentFreeDays Int          @default(3)
  createdAt          DateTime     @default(now())
  containers         Container[]
  tariffs            Tariff[]

  @@unique([organizationId, code])
}

model Container {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  containerNumber    String
  containerType      String             @default("DRY")
  size               Int                @default(20) // 20 or 40 ft
  status             ContainerStatus    @default(DISCHARGED)
  deliveryMode       DeliveryMode       @default(CFS)
  cfsId              String?
  cfs                CFS?               @relation(fields: [cfsId], references: [id])
  carrier            String?
  billOfLading       String?
  bookingNumber      String?
  declaredValue      Float?
  currency           String             @default("INR")
  hsCode             String?
  dischargeDate      DateTime?
  freeTimeExpiresAt  DateTime?
  gateInDate         DateTime?
  gateOutDate        DateTime?
  deliveryOrderDate  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  events             ContainerEvent[]
  charges            Charge[]
  complianceSignals  ComplianceSignal[]
  documents          Document[]
  tasks              Task[]
  alerts             Alert[]

  @@index([organizationId, clientId])
  @@index([containerNumber])
}

model ContainerEvent {
  id          String    @id @default(uuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  eventType   String    // e.g. DISCHARGE, DPD_TO_CFS_FALLBACK, CFS_GATE_IN, PICKUP_SCHEDULED
  timestamp   DateTime  @default(now())
  location    String?
  source      String    @default("SYSTEM") // SYSTEM, USER, EXTERNAL, EDI
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([containerId, timestamp])
}

model Tariff {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  carrier        String?
  cfsId          String?
  cfs            CFS?         @relation(fields: [cfsId], references: [id])
  chargeType     ChargeType
  slabDaysStart  Int
  slabDaysEnd    Int          // 999 for infinity
  ratePerDay20   Float
  ratePerDay40   Float
  currency       String       @default("INR")
  effectiveFrom  DateTime     @default(now())

  @@index([organizationId, chargeType])
}

model Charge {
  id                   String     @id @default(uuid())
  containerId          String
  container            Container  @relation(fields: [containerId], references: [id], onDelete: Cascade)
  chargeType           ChargeType
  amount               Float
  currency             String     @default("INR")
  daysCalculated       Int        @default(0)
  calculationBreakdown Json?
  isAuthoritative      Boolean    @default(true)
  createdAt            DateTime   @default(now())

  @@index([containerId])
}

model ComplianceSignal {
  id          String               @id @default(uuid())
  containerId String
  container   Container            @relation(fields: [containerId], references: [id], onDelete: Cascade)
  signalType  ComplianceSignalType
  score       Int                  // 0 - 100
  source      SignalSource         // MANUAL | DERIVED
  reason      String?
  metadata    Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([containerId, signalType])
  @@index([containerId])
}

model Document {
  id                      String             @id @default(uuid())
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId                String
  client                  Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  containerId             String?
  container               Container?         @relation(fields: [containerId], references: [id], onDelete: SetNull)
  documentType            DocumentType
  fileName                String
  fileSize                Int
  mimeType                String
  fileUrl                 String
  extractionStatus        ExtractionStatus   @default(PENDING)
  overallConfidence       Float?
  flaggedForReview        Boolean            @default(true)
  reviewStatus            ReviewStatus       @default(PENDING_REVIEW)
  reviewerId              String?
  originalExtractedFields Json?
  acceptedFields          Json?
  fieldLevelConfidence    Json?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  provenanceRecords       DocumentExtractionProvenance[]

  @@index([organizationId, clientId])
  @@index([containerId])
}

model DocumentExtractionProvenance {
  id                   String       @id @default(uuid())
  documentId           String
  document             Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractionVersion    String
  modelVersion         String
  overallConfidence    Float
  fieldLevelConfidence Json?
  reviewStatus         ReviewStatus
  reviewerId           String?
  originalFields       Json?
  acceptedFields       Json?
  correctedFields      Json?
  createdAt            DateTime     @default(now())

  @@index([documentId])
}

model Task {
  id                    String        @id @default(uuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  containerId           String?
  container             Container?    @relation(fields: [containerId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  taskType              TaskType      @default(PICKUP)
  status                TaskStatus    @default(PENDING)
  assigneeType          AssigneeType  @default(INTERNAL_USER)
  assignedUserId        String?
  assignedUser          User?         @relation(fields: [assignedUserId], references: [id])
  externalContactName   String?
  externalContactEmail  String?
  externalContactPhone  String?
  pickupLocation        String?
  scheduledDate         DateTime?
  confirmationTokenHash String?       @unique // SHA-256 hash of external token
  tokenExpiresAt        DateTime?
  tokenRevokedAt        DateTime?
  confirmedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  confirmations         ExternalTaskConfirmationAudit[]

  @@index([organizationId])
  @@index([containerId])
}

model ExternalTaskConfirmationAudit {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tokenHash   String
  ipAddress   String?
  userAgent   String?
  action      String   @default("CONFIRM_PICKUP")
  confirmedAt DateTime @default(now())

  @@index([taskId])
}

model Alert {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  containerId    String?
  container      Container?   @relation(fields: [containerId], references: [id], onDelete: SetNull)
  severity       RiskSeverity @default(MEDIUM)
  title          String
  message        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, isRead])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actorType      String       @default("USER") // USER, SYSTEM, EXTERNAL
  action         String
  targetType     String       // CONTAINER, DOCUMENT, COMPLIANCE_SIGNAL, TASK
  targetId       String
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, targetType, targetId])
  @@index([createdAt])
}
