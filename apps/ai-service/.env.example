# DemurrageOS AI Extraction & Knowledge Service Configuration
PORT=8000
ENVIRONMENT=development
DEBUG=false

# Authoritative Backend API
BACKEND_API_URL=http://localhost:4000
INTERNAL_SERVICE_KEY=

# Google Gemini API (Optional: used to augment standard regex/heuristics extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ChromaDB Vector Database Storage Directory
CHROMA_DB_DIR=./chroma_db

# Port DPD Clearance Rules
DPD_PICKUP_WINDOW_HOURS=48
